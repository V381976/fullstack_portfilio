{
  "version": 1.1,
  "atDirectives": [
    {
      "name": "@tailwind",
      "description": "Injects Tailwind's base, components, or utilities styles",
      "references": [
        {
          "name": "Tailwind CSS Documentation",
          "url": "https://tailwindcss.com/docs/functions-and-directives"
        }
      ]
    },
    {
      "name": "@apply",
      "description": "Inline any existing utility classes",
      "references": [
        {
          "name": "Tailwind CSS Documentation",
          "url": "https://tailwindcss.com/docs/functions-and-directives#apply"
        }
      ]
    },
    {
      "name": "@layer",
      "description": "Defines custom CSS layers",
      "references": [
        {
          "name": "Tailwind CSS Documentation",
          "url": "https://tailwindcss.com/docs/functions-and-directives#layer"
        }
      ]
    },
    {
      "name": "@config",
      "description": "Specifies which config file to use",
      "references": [
        {
          "name": "Tailwind CSS Documentation",
          "url": "https://tailwindcss.com/docs/functions-and-directives#config"
        }
      ]
    },
    {
      "name": "@variant",
      "description": "Adds custom variants",
      "references": [
        {
          "name": "Tailwind CSS Documentation",
          "url": "https://tailwindcss.com/docs/functions-and-directives#variant"
        }
      ]
    }
  ]
}
